# First-boot editor password (change it later in Editor > Settings)
ADMIN_PASSWORD=change-me
PORT=3000

# Leave these empty locally: the site then uses ./data and ./public/uploads.
# On Vercel they're filled in for you when you connect Neon and Blob storage.
# DATABASE_URL=postgres://...
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
